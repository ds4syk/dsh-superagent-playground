 4 files changed, 93 insertions(+), 18 deletions(-)

diff --git a/src/sdprlayers/__init__.py b/src/sdprlayers/__init__.py
index 51bb865..ff17863 100644
--- a/src/sdprlayers/__init__.py
+++ b/src/sdprlayers/__init__.py
@@ -1,8 +1,36 @@
-from sdprlayers.layers.essential_est import SDPEssMatEst
-from sdprlayers.layers.fundmat_est import FundMatSDPBlock
-from sdprlayers.layers.lieopt_pose_est import LieOptPoseEstimator
 from sdprlayers.layers.polyminlayer import PolyMinLayer, polyval
 from sdprlayers.layers.pose_est import SDPPoseEstimator
 from sdprlayers.layers.sdprlayer import SDPRLayer, SDPRLayerMosek
 from sdprlayers.layers.svd_pose_est import SVDPoseEstimator
 from sdprlayers.utils import stereo_tuner
+
+# Optional, heavyweight layers are imported lazily so that a plain
+# ``import sdprlayers`` works on a minimal installation:
+#  * ``SDPEssMatEst`` / ``FundMatSDPBlock`` need the ``cert_tools`` stack, which
+#    imports ``mosek`` (commercial license) and cvxopt/chompack/igraph at module
+#    scope;
+#  * ``LieOptPoseEstimator`` needs ``theseus``, whose import chain pulls in
+#    ``sksparse`` (SuiteSparse CHOLMOD), a native dependency that is not always
+#    present.
+_OPTIONAL_LAYERS = {
+    "SDPEssMatEst": "sdprlayers.layers.essential_est",
+    "FundMatSDPBlock": "sdprlayers.layers.fundmat_est",
+    "LieOptPoseEstimator": "sdprlayers.layers.lieopt_pose_est",
+}
+
+
+def __getattr__(name):
+    if name in _OPTIONAL_LAYERS:
+        import importlib
+
+        try:
+            module = importlib.import_module(_OPTIONAL_LAYERS[name])
+        except ImportError as exc:  # pragma: no cover - depends on env
+            raise ImportError(
+                f"sdprlayers.{name} requires an optional dependency stack "
+                f"(cert_tools/mosek or theseus/sksparse): {exc}"
+            ) from exc
+        value = getattr(module, name)
+        globals()[name] = value
+        return value
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
