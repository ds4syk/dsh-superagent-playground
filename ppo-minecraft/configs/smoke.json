{
  "run": {
    "name": "smoke",
    "seed": 0,
    "num_envs": 2,
    "torch_threads": 2,
    "device": "cpu"
  },
  "env": {
    "repeat": 2,
    "episode_steps": 256
  },
  "ppo": {
    "total_steps": 128,
    "rollout_steps": 64,
    "chunk_len": 32,
    "epochs": 2,
    "minibatch_chunks": 4,
    "lr": 0.0003,
    "reward_scale": 5.0
  },
  "logging": {
    "save_every_updates": 2,
    "log_every_updates": 1
  }
}
