+		ExternalRef: "c", ProjectID: "other", RequestFingerprint: "fp", Spawn: spawnConfig("other"),
+	}); err != nil {
+		t.Fatalf("ensure other: %v", err)
+	}
+	got, err := svc.List(ctx, "proj")
