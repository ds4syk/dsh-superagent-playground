From c2c0922d5bf9737d348fcb2f481803225a25f61d Mon Sep 17 00:00:00 2001
From: syk <syk@local>
Date: Sat, 31 Oct 2026 13:57:18 +0800
Subject: [PATCH 1/4] experiment: env-overridable kkt_tol/SCS eps/dual-form;
 informative residual messages; explicit non-tight error

---
 src/sdprlayers/layers/pose_est.py  | 18 ++++++++++++++++++
 src/sdprlayers/layers/sdprlayer.py | 18 ++++++++++++------
 2 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/src/sdprlayers/layers/pose_est.py b/src/sdprlayers/layers/pose_est.py
index 02ccdb3..296c3ef 100644
--- a/src/sdprlayers/layers/pose_est.py
+++ b/src/sdprlayers/layers/pose_est.py
@@ -1,3 +1,5 @@
+import os
+
 import numpy as np
 import torch
 import torch.nn as nn
@@ -38,6 +40,16 @@ class SDPPoseEstimator(nn.Module):
         """
         super(SDPPoseEstimator, self).__init__()
 
+        # ---- experimental overrides (used by the solve-failure fix study) ----
+        # These default to the upstream behaviour when the env vars are unset.
+        _dual_env = os.environ.get("SDPR_USE_DUAL")
+        if _dual_env is not None:
+            use_dual = _dual_env.strip().lower() not in ("0", "false", "no")
+        self.use_dual = use_dual
+        _eps_env = os.environ.get("SDPR_SCS_EPS")
+        if _eps_env is not None:
+            scs_eps = float(_eps_env)
+
         # Generate constraints
         constraints = (
             self.gen_orthogonal_constraints()
@@ -137,6 +149,12 @@ class SDPPoseEstimator(nn.Module):
                 Xs, xs = self.sdprlayer(Qs, solver_args=layer_solver_args)
 
         # Extract solution
+        if xs is None:
+            raise RuntimeError(
+                "SDPR: relaxation is not tight (rank-1 recovery failed); "
+                "cannot return a pose. Try tighter solver tolerance / different "
+                "reformulation, or treat this instance as a solver failure."
+            )
         t_trg_src_intrg = xs[:, 10:]
         R_trg_src = torch.reshape(xs[:, 1:10], (-1, 3, 3)).transpose(-1, -2)
         t_src_trg_intrg = -t_trg_src_intrg
diff --git a/src/sdprlayers/layers/sdprlayer.py b/src/sdprlayers/layers/sdprlayer.py
index c964191..af290e7 100644
--- a/src/sdprlayers/layers/sdprlayer.py
+++ b/src/sdprlayers/layers/sdprlayer.py
@@ -1,3 +1,4 @@
+import os
 from copy import deepcopy
 
 import cvxpy as cp
@@ -28,7 +29,7 @@ mosek_params_dflt = {
 # constraint gradient matrix that is treated as non-zero.
 LICQ_TOL = 1e-8
 # Tolerance for norm of residuals of the KKT conditions.
-KKT_TOL = 1e-5
+KKT_TOL = float(os.environ.get("SDPR_KKT_TOL", 1e-5))  # env override for experiments
 # Tolerance for residuals in LSQR solve
 # (see https://docs.scipy.org/doc/scipy/reference/generated/scipy.sparse.linalg.lsqr.html#lsqr)
 LSQR_TOL = 1e-12
@@ -580,8 +581,10 @@ def _QCQPDiffFn(
                     lstsq_res = la.lstsq(G_r.T, -q_bar, cond=ctx.licq_tol)
                     mults_ = lstsq_res[0]
                     residual = G_r.T @ mults_ + q_bar
-                    assert np.linalg.norm(residual) < ctx.kkt_tol, ValueError(
-                        "Failed to find adequate Lagrange multipliers"
+                    _res_norm = float(np.linalg.norm(residual))
+                    assert _res_norm < ctx.kkt_tol, ValueError(
+                        "Failed to find adequate Lagrange multipliers "
+                        f"(residual={_res_norm:.3e} > kkt_tol={ctx.kkt_tol:.1e})"
                     )
                     H_list = [sp.csc_array(Q)]
                     all_mults = []
@@ -646,12 +649,15 @@ def _QCQPDiffFn(
                         sol, res = _solve_diff_kkt(H, G_r, G_r)
 
                 # Check that certificate matrix satisfies the first order KKT conditions
-                assert np.linalg.norm(H @ x) < ctx.kkt_tol, ValueError(
-                    "First-order KKT conditions cannot be satisfied! Check Certificate matrix."
+                _hx_norm = float(np.linalg.norm(H @ x))
+                assert _hx_norm < ctx.kkt_tol, ValueError(
+                    "First-order KKT conditions cannot be satisfied! Check Certificate matrix. "
+                    f"(||Hx||={_hx_norm:.3e} > kkt_tol={ctx.kkt_tol:.1e})"
                 )
                 # Check that we have actually solved the differential KKT system
                 assert res < ctx.kkt_tol, ValueError(
-                    "Differential KKT system residual is high. Make sure that redundant constraints are actually redundant and that the certificate matrix is correct."
+                    "Differential KKT system residual is high. Make sure that redundant constraints are actually redundant and that the certificate matrix is correct. "
+                    f"(residual={float(res):.3e} > kkt_tol={ctx.kkt_tol:.1e})"
                 )
                 dy_bar = sol
                 dy_bar_1 = dy_bar[:nvars, :]
-- 
