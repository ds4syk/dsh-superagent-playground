+
+const listExternalSessionsByProject = `-- name: ListExternalSessionsByProject :many
+SELECT external_ref, project_id, session_id, assignment_ref, request_fingerprint, created_at, updated_at
+FROM external_sessions
+WHERE project_id = ?
+ORDER BY created_at DESC, external_ref
+`
+
+func (q *Queries) ListExternalSessionsByProject(ctx context.Context, projectID domain.ProjectID) ([]ExternalSession, error) {
+	rows, err := q.db.QueryContext(ctx, listExternalSessionsByProject, projectID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []ExternalSession{}
+	for rows.Next() {
+		var i ExternalSession
+		if err := rows.Scan(
+			&i.ExternalRef,
+			&i.ProjectID,
+			&i.SessionID,
+			&i.AssignmentRef,
+			&i.RequestFingerprint,
+			&i.CreatedAt,
+			&i.UpdatedAt,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
+
+const updateExternalSessionAssignment = `-- name: UpdateExternalSessionAssignment :exec
+UPDATE external_sessions
+SET assignment_ref = ?, updated_at = ?
+WHERE external_ref = ?
+`
+
+type UpdateExternalSessionAssignmentParams struct {
+	AssignmentRef string
+	UpdatedAt     time.Time
+	ExternalRef   string
+}
+
+func (q *Queries) UpdateExternalSessionAssignment(ctx context.Context, arg UpdateExternalSessionAssignmentParams) error {
+	_, err := q.db.ExecContext(ctx, updateExternalSessionAssignment, arg.AssignmentRef, arg.UpdatedAt, arg.ExternalRef)
+	return err
+}
