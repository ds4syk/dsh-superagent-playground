+		t.Fatalf("error = %v, want not found", err)
+	}
+}
+
+func TestListProjectsExternalSessions(t *testing.T) {
+	store, sessions := newFakeStore(), newFakeSessions()
+	svc := New(store, sessions)
+	ctx := context.Background()
+	for _, ref := range []string{"a", "b"} {
